# Dynamo Environment Variables

# The directory where the encrypted vault files and manifest will be stored.
DATA_DIR=/app/data

# Dynamic shuffling interval in hours. Default is 6.
SHUFFLE_INTERVAL_HOURS=6

# Session inactivity timeout in minutes before auto-locking.
SESSION_TIMEOUT_MINUTES=15

# Maximum allowed upload size in MB (enforced on backend or proxy)
MAX_UPLOAD_SIZE_MB=1024
